#!/bin/bash
set -e

# Create per-user config if it doesn't exist

if [ -n "$SUDO_USER" ]; then
    USER_HOME=$(eval echo "~$SUDO_USER")
    CONFIG_DIR="$USER_HOME/.config/lfetch"
    
    if [ ! -d "$CONFIG_DIR" ]; then
        mkdir -p "$CONFIG_DIR"
        chown "$SUDO_USER:$SUDO_USER" "$CONFIG_DIR"
    fi
    
    if [ ! -f "$CONFIG_DIR/config.json" ]; then
        cp /usr/share/lfetch/config.json.default "$CONFIG_DIR/config.json"
        chown "$SUDO_USER:$SUDO_USER" "$CONFIG_DIR/config.json"
        echo "✓ Created default config at $CONFIG_DIR/config.json"
    fi
fi

# Also try to set up for the current user running dpkg/apt
if [ -n "$USER" ] && [ "$USER" != "root" ]; then
    USER_HOME="$HOME"
    CONFIG_DIR="$USER_HOME/.config/lfetch"
    
    if [ ! -d "$CONFIG_DIR" ]; then
        mkdir -p "$CONFIG_DIR"
    fi
    
    if [ ! -f "$CONFIG_DIR/config.json" ]; then
        cp /usr/share/lfetch/config.json.default "$CONFIG_DIR/config.json"
        echo "✓ Created default config at $CONFIG_DIR/config.json"
    fi
fi

